# PopDEX 网格机器人
# 交易对、K线周期、趋势分析、网格区间、网格数量、模式、每格数量和杠杆均在前端选择/填写。
MODE=live
HOST=0.0.0.0
PORT=8080

# PopDEX 主网公开接口（固定配置，普通使用无需修改）
POPDEX_NETWORK=mainnet
POPDEX_API_BASE=https://api.popdex.xyz
POPDEX_TICKER_PATH=/api/v1/public/market/tickers
POPDEX_TICKER_JSON_PATH=data.0.lastPrice
POPDEX_API_CATEGORY=Futures

# 普通使用只需要填写这两项
# Agent 私钥必须是已授权 Agent Account 私钥，不要填写主钱包私钥
POPDEX_AGENT_PRIVATE_KEY=
# 主账户地址，也可以在前端连接钱包后自动读取
POPDEX_MAIN_ACCOUNT=

# 以下是固定链上执行参数，程序已有默认值，普通使用无需填写
# POPDEX_RPC_URL=https://app.popdex.xyz/api/v1/web3/rpc
# POPDEX_ORDER_CONTRACT=0x0000000000000000000000000000000000001000
# POPDEX_SYMBOL_ID=20000
# POPDEX_CATEGORY=2
# POPDEX_POSITION_SIDE=0
