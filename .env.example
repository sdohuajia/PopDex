# 默认不会发送链上交易
MODE=paper
HOST=0.0.0.0
PORT=8080

# PopDEX 官方公开接口（Mainnet）
POPDEX_NETWORK=mainnet
POPDEX_API_BASE=https://api.popdex.xyz
POPDEX_PUBLIC_WS=wss://ws.popdex.xyz/v1/ws/public
POPDEX_TICKER_PATH=/api/v1/public/market/tickers
POPDEX_TICKER_JSON_PATH=data.0.lastPrice
POPDEX_API_CATEGORY=Futures
# 官方文档示例格式为 BTCUSDT；请改为当前可交易的实际 symbol
POPDEX_SYMBOL=

# 网格策略（同参考脚本）
LOWER=90000
UPPER=110000
GRID_COUNT=20
ORDER_SIZE_BASE=0.001
GRID_MODE=neutral
SKIP_BAND=0.25
POLL_MS=1500
PAPER_START_PRICE=100000
PAPER_VOLATILITY=0.002
PAPER_BALANCE=10000
FEE_RATE=0.0005

# 实盘链上执行：以下四项必须从 PopDEX 的当前合约/账户信息中确认，故留空
# MODE=live
HOST=0.0.0.0
PORT=8080
# POPDEX_RPC_URL=
# POPDEX_AGENT_PRIVATE_KEY=0x...
# POPDEX_MAIN_ACCOUNT=0x...
# POPDEX_ORDER_CONTRACT=0x...
# POPDEX_SYMBOL_ID=
# POPDEX_CATEGORY=
# POPDEX_POSITION_SIDE=




